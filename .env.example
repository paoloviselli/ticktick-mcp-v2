# TickTick MCP Server Configuration
# Copy this file to .env and fill in your credentials
#
# SETUP GUIDE:
# 1. Register app at https://developer.ticktick.com/manage
# 2. Fill in CLIENT_ID and CLIENT_SECRET below
# 3. Run: python scripts/get_oauth_token.py
# 4. Paste the access token in TICKTICK_ACCESS_TOKEN
# 5. Add your TickTick username and password

# =============================================================================
# V1 API (OAuth2) - REQUIRED
# =============================================================================

# Your application's client ID (from developer portal)
TICKTICK_CLIENT_ID=

# Your application's client secret (from developer portal)
TICKTICK_CLIENT_SECRET=

# OAuth2 redirect URI (must match your app registration)
TICKTICK_REDIRECT_URI=http://127.0.0.1:8080/callback

# Access token obtained through OAuth2 flow
# Run: python scripts/get_oauth_token.py
TICKTICK_ACCESS_TOKEN=

# =============================================================================
# V2 API (Session) - REQUIRED
# =============================================================================

# Your TickTick account email
TICKTICK_USERNAME=

# Your TickTick account password
TICKTICK_PASSWORD=

# Optional warm-start optimization for V2 auth.
# STDIO prefers this when present. HTTP/Vercel treats it as a bootstrap hint
# and still falls back to username/password on cold starts or expiry.
TICKTICK_V2_SESSION_TOKEN=

# =============================================================================
# Optional Settings
# =============================================================================

# API host (default: ticktick.com)
# Use dida365.com for Chinese version (滴答清单)
# TICKTICK_HOST=ticktick.com

# Request timeout in seconds (default: 30)
# TICKTICK_TIMEOUT=30

# Device ID for V2 API (auto-generated if not set)
# TICKTICK_DEVICE_ID=

# Transport mode used by the server runtime. Leave unset for local STDIO.
# Set to http only when serving Streamable HTTP directly.
# TICKTICK_TRANSPORT_MODE=stdio

# Optional bearer token that protects the public HTTP MCP endpoint.
# When set, every HTTP request must send:
#   Authorization: Bearer <this token>
# Leave unset for local development if you do not want HTTP auth.
MCP_BEARER_TOKEN=
