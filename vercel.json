{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
